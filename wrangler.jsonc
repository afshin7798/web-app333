{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app333",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "c697c5b0-71ed-4e98-b272-35deb82a4308","database_name": "web-app333" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6021538be7f04c28aebf6ac186d2535b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
